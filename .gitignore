/target/
# wasm-pack output
/crates/reactor-wasm/pkg/
__pycache__/
*.py[cod]
.venv/
dist/
dist-unrepaired/
*.egg-info/
node_modules/
.env
.env.local
.env.*.local
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Playwright's own output (sdks/js/integration-tests)
/sdks/js/integration-tests/test-results/
/sdks/js/integration-tests/playwright-report/

# Python/C++/Swift SDK endurance-tests: JSON/Markdown/text reports (and, on
# a failure, the Endurance tests workflow's crash-diagnostics JSON) written
# by each scenario's own run — see sdks/python/endurance-tests/report.py,
# sdks/cpp/endurance-tests/report.hpp and
# sdks/swift/EnduranceReporting/Report.swift. Local/CI output, never
# something to commit.
/sdks/python/endurance-results/
/sdks/cpp/endurance-results/
/sdks/swift/endurance-results/
/sdks/java/endurance-tests/endurance-results/

# C++ SDK build tree (cmake -B sdks/cpp/build)
/sdks/cpp/build/
# The integration suite's own build tree (mise run test:cpp:integration-tests),
# kept separate from build/ so REACTOR_SDK_BUILD_INTEGRATION_TESTS=ON never
# shares a CMake cache with the default build.
/sdks/cpp/build-integration-tests/
# JVM fatal-error dumps. A crash in a test writes one into whatever directory the
# JVM was started in, carrying local paths, host details and register state — and
# one was committed, 1,800 lines of it, before anyone noticed.
hs_err_pid*.log
replay_pid*.log

# Same reasoning, for the endurance suite (mise run test:cpp:endurance-tests).
/sdks/cpp/build-endurance-tests/
# Swift SDK: SwiftPM's build tree and per-user state. The manifest is at the
# repository root, so these land there too.
/.build/
/.swiftpm/
*.xcframework
# clangd's index, written wherever it finds a compile_commands.json — which is
# any directory, hence the leading **.
**/.cache/clangd/

# Java SDK: Gradle's build output and per-project state, for every module and
# for buildSrc. There is no Gradle wrapper to ignore — mise pins Gradle instead,
# see sdks/java/settings.gradle.kts.
/sdks/java/**/build/
/sdks/java/.gradle/
/sdks/java/buildSrc/.gradle/

# Android SDK: Gradle's build output and per-project state, for every module and
# for buildSrc. There is no Gradle wrapper to ignore — mise pins Gradle instead,
# see sdks/android/settings.gradle.kts. local.properties is Android Studio's, and
# would pin an sdk.dir that only exists on the machine that wrote it; the SDK root
# comes from ANDROID_HOME, which the mise android-sdk tool exports.
/sdks/android/**/build/
/sdks/android/.gradle/
/sdks/android/buildSrc/.gradle/
/sdks/android/.kotlin/
/sdks/android/local.properties

# Java SDK: native libraries staged for packaging. Built by `mise run build:ffi`
# locally and by the release workflow's matrix in CI — tens of megabytes each,
# and never something to commit.
/sdks/java/reactor-sdk-natives/natives/
