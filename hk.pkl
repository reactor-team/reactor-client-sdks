amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"

// Git hooks for reactor-client-sdks, managed by hk (`mise run install-hooks`).
//
// Every step shells out to a `mise run <task>`, so the hooks and CI run the
// IDENTICAL checks - hk only decides WHEN they run. hk reads this file with its
// built-in pkl evaluator (no separate pkl tool); `hk validate` (run in CI)
// proves it parses.
hooks {
  // Fast, offline checks - nothing here compiles or hits the network.
  ["pre-commit"] {
    steps {
      ["fmt"] {
        glob = List("*.rs")
        check = "mise run fmt:check"
      }
      ["shell"] {
        glob = List("*.sh", "*.bash")
        check = "mise run lint:shell"
        exclusive = true
      }
      ["mise-tools-root"] {
        glob = List("**/mise.toml")
        check = "mise run lint:mise-tools-root"
        exclusive = true
      }
      ["python"] {
        glob = List("*.py")
        check = "mise run lint:python"
        exclusive = true
      }
      // Formatting only. clang-tidy is a compile and needs libreactor_ffi, so it
      // belongs to CI and to `mise run lint:cpp`, not to a hook meant to be fast.
      ["cpp-format"] {
        glob = List("*.cpp", "*.hpp")
        check = "mise run fmt:cpp:check"
        exclusive = true
      }
      // The ABI is declared in more than one hand-written place; this catches
      // them drifting, and catches a C++ source naming a symbol Rust does not
      // export. Text-only, so it belongs in the fast hook.
      //
      // The Python path here used to read sdks/python/reactor/_ffi.py, which has
      // never existed — so editing the ctypes declarations never triggered the
      // one check that covers them.
      ["abi-parity"] {
        glob = List(
          "crates/reactor-ffi/src/lib.rs",
          "crates/reactor-ffi/include/*.h",
          "sdks/python/reactor_sdk/_ffi.py",
          "sdks/cpp/**/*.cpp",
          "sdks/cpp/**/*.hpp",
          "scripts/check-abi-parity.py"
        )
        check = "mise run lint:abi"
        exclusive = true
      }
    }
  }
  // Heavier checks before pushing: clippy compiles, and the lockfile drift
  // check runs (skipped when mise.toml + mise.lock already match the merge-base
  // with main).
  ["pre-push"] {
    steps {
      ["clippy"] {
        glob = List("*.rs")
        check = "mise run clippy"
        exclusive = true
      }
      ["mise-lock"] {
        check = "mise run lint:mise-lock"
        exclusive = true
      }
      ["test"] {
        glob = List("*.rs", "*.py", "*.cpp", "*.hpp")
        check = "mise run test"
        exclusive = true
      }
    }
  }
  // Auto-trust mise on every checkout - including `git worktree add`, which
  // fires post-checkout inside the new worktree - so the pinned tools resolve
  // without a manual `mise trust`.
  ["post-checkout"] {
    steps {
      ["mise-trust"] {
        check = "mise trust --yes --quiet 2>/dev/null || true"
        exclusive = true
      }
    }
  }
}
