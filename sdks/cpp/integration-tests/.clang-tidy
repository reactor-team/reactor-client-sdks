# Integration-test code, on top of the SDK's own config.
#
# Not run by `mise run lint:cpp` today (its glob is `src/**` and `tests/*.cpp`
# only, the same as `examples/` is left out) — kept here anyway so an editor
# running clang-tidy live against this directory sees the same relaxations
# `sdks/cpp/tests/.clang-tidy` grants the unit suite.
InheritParentConfig: true

Checks: >
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-avoid-const-or-ref-data-members
