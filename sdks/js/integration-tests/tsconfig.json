{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["@playwright/test"],
    "noEmit": true
  },
  "include": ["harness/src", "harness/vite.config.ts", "tests", "playwright.config.ts"]
}
